{
  "name": "hydrafetch/hydrafetch",
  "description": "Official PHP client for the Hydrafetch web data API. Turn any URL into clean Markdown and structured data.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://hydrafetch.com",
  "keywords": ["hydrafetch", "scraping", "markdown", "llm", "rag", "crawler", "web-data"],
  "support": {
    "issues": "https://github.com/Hydrafetch/php-sdk/issues",
    "docs": "https://docs.hydrafetch.com"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "Hydrafetch\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Hydrafetch\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
